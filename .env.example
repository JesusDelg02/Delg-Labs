# Resend (https://resend.com) — required for the contact form to actually send email
RESEND_API_KEY=

# Once you've verified a sending domain in Resend, set this to a real address.
# Until you do, actions/contact.ts's default "from" (onboarding@resend.dev) will
# only deliver to the Resend account's own verified email — it will NOT reach
# real visitors' messages to a custom inbox address.
CONTACT_INBOX_EMAIL=
